{
  "datasets": [
    {
      "name": "ds_limits",
      "displayName": "Limits (latest)",
      "queryLines": [
        "WITH ctx AS (SELECT cloud FROM scan_context),\n",
        "usage AS (\n",
        "  SELECT limit_id,\n",
        "         max_by(coalesce(parent_name, 'workspace ' || workspace_id), coalesce(pct_used, -1)) AS top_parent,\n",
        "         max_by(usage_count, coalesce(pct_used, -1)) AS usage_count,\n",
        "         max(pct_used) AS pct_used,\n",
        "         bool_and(full_visibility) AS full_visibility,\n",
        "         max(scan_ts) AS scan_ts\n",
        "  FROM latest_usage\n",
        "  GROUP BY limit_id\n",
        ")\n",
        "SELECT r.limit_id, r.level, r.area, r.resource, r.scope,\n",
        "       r.resource || ' per ' || r.scope AS limit_name,\n",
        "       CASE ctx.cloud WHEN 'aws' THEN r.limit_aws WHEN 'azure' THEN r.limit_azure ELSE r.limit_gcp END AS limit_value,\n",
        "       u.usage_count, u.top_parent,\n",
        "       round(u.pct_used / 100.0, 4) AS pct_used,\n",
        "       CASE WHEN u.limit_id IS NULL THEN 'Not measured'\n",
        "            WHEN u.pct_used IS NULL THEN 'Unknown (no limit for this cloud)'\n",
        "            WHEN u.pct_used >= 90 THEN 'Critical (90%+)'\n",
        "            WHEN u.pct_used >= 70 THEN 'Warning (70-90%)'\n",
        "            ELSE 'OK (under 70%)' END AS status,\n",
        "       CASE WHEN u.limit_id IS NOT NULL THEN 1 ELSE 0 END AS is_measured,\n",
        "       CASE WHEN u.pct_used >= 70 THEN 1 ELSE 0 END AS is_warning,\n",
        "       CASE WHEN u.pct_used >= 90 THEN 1 ELSE 0 END AS is_critical,\n",
        "       CASE WHEN r.adjustable THEN 'Yes: request via account team' ELSE 'No (fixed)' END AS raisable,\n",
        "       CASE WHEN u.full_visibility THEN 'Complete' WHEN u.limit_id IS NULL THEN '' ELSE 'Lower bound' END AS count_quality,\n",
        "       r.measure_method, r.release_status, r.notes, u.scan_ts,\n",
        "       CASE ctx.cloud WHEN 'aws' THEN r.source_url_aws WHEN 'azure' THEN r.source_url_azure ELSE r.source_url_gcp END AS source_url\n",
        "FROM limits_reference r CROSS JOIN ctx\n",
        "LEFT JOIN usage u ON u.limit_id = r.limit_id\n",
        "ORDER BY u.pct_used DESC NULLS LAST, r.area, r.limit_id\n"
      ]
    },
    {
      "name": "ds_parents",
      "displayName": "Usage by parent (latest)",
      "queryLines": [
        "SELECT u.limit_id, r.level, r.area, r.resource || ' per ' || r.scope AS limit_name,\n",
        "       coalesce(u.parent_name,\n",
        "                CASE WHEN u.workspace_id IS NOT NULL THEN 'workspace ' || u.workspace_id\n",
        "                     ELSE '(whole ' || r.scope || ')' END) AS parent_name,\n",
        "       u.workspace_id,\n",
        "       u.usage_count, u.limit_value, round(u.pct_used / 100.0, 4) AS pct_used,\n",
        "       CASE WHEN u.full_visibility THEN 'Complete' ELSE 'Lower bound' END AS count_quality,\n",
        "       u.source, u.scan_ts\n",
        "FROM latest_usage u\n",
        "JOIN limits_reference r ON r.limit_id = u.limit_id\n",
        "ORDER BY u.pct_used DESC NULLS LAST\n"
      ]
    },
    {
      "name": "ds_trend",
      "displayName": "Trend (top limits)",
      "queryLines": [
        "WITH top_limits AS (\n",
        "  SELECT limit_id FROM latest_usage GROUP BY limit_id ORDER BY max(pct_used) DESC NULLS LAST LIMIT 6\n",
        ")\n",
        "SELECT DATE_TRUNC('DAY', u.scan_ts) AS scan_day,\n",
        "       u.limit_id, r.level, r.area,\n",
        "       r.resource || ' per ' || r.scope AS limit_name,\n",
        "       round(max(u.pct_used) / 100.0, 4) AS pct_used\n",
        "FROM limit_usage u\n",
        "JOIN top_limits t ON t.limit_id = u.limit_id\n",
        "JOIN limits_reference r ON r.limit_id = u.limit_id\n",
        "WHERE u.scan_ts >= date_sub(current_date(), 90)\n",
        "GROUP BY 1, 2, 3, 4, 5\n",
        "ORDER BY 1\n"
      ]
    },
    {
      "name": "ds_changes",
      "displayName": "Limit changes",
      "queryLines": [
        "SELECT c.detected_on, c.limit_id,\n",
        "       coalesce(r.resource || ' per ' || r.scope, c.limit_id) AS limit_name,\n",
        "       c.change_type, c.cloud, c.old_value, c.new_value, c.source_url\n",
        "FROM limit_changes c\n",
        "LEFT JOIN limits_reference r ON r.limit_id = c.limit_id\n",
        "WHERE c.change_type <> 'added' OR c.detected_on > (SELECT min(detected_on) FROM limit_changes)\n",
        "ORDER BY c.logged_at DESC\n"
      ]
    }
  ],
